# Application Settings
APP_ENV=development
SECRET_KEY=super-secret-jwt-encryption-key-change-in-production-123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + pgvector or SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./codebase_analysis.db
# For Docker / PostgreSQL + pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codebase_analysis

# Storage Paths
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
REPOS_DIR=./storage/repos
EXPORTS_DIR=./storage/exports
MAX_UPLOAD_SIZE_MB=100

# LLM Configuration (Provider agnostic: openai, anthropic, gemini, or heuristic/local)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web Search (tavily or duckduckgo)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false
